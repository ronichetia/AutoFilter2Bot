# ──────────────────────────────────────────────────────────
#  AutoFilterBot – Environment Variables
#  Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=35585958
API_HASH=5c3e3e9cca5b0cf55845e0be1410f8b2

# MongoDB connection string (Atlas or local)
MONGO_URI=

# ── Bot Admins & Channels ───────────────────────────────

# Space-separated list of admin Telegram user IDs
ADMINS=5953067512

# Channel/group ID where bot logs are sent (include the minus sign)
LOG_CHANNEL=-1003932170332

# Channel ID users must join before using the bot (force subscribe)
FORCE_SUB_CHANNEL=-1003726486971

# ── Optional / Defaults ─────────────────────────────────

# Port for the built-in health-check server (default: 8080)
PORT=8080

# Name shown in /start and help messages
BOT_NAME=AutoBot

# Maximum number of search results per page (default: 10)
MAX_RESULTS=10

# Maximum number of pages of results (default: 5)
MAX_PAGES=5

# Custom /start photo or animation URL (optional)
START_PIC=

# Enable premium features (true/false, default: false)
PREMIUM_ENABLED=true

# Auto-delete messages after N seconds (0 = disabled)
AUTO_DELETE_SECONDS=300

# Token verification link expiry in seconds (default: 600)
TOKEN_EXPIRY=600

# Short-link API for token verification (e.g. shortzon, atglinks)
SHORTLINK_API=f53a940f63c61910b875cc8bf254fead8b15fef0
SHORTLINK_URL=arolinks.com

# Custom MongoDB database name (default: autofilter)
DB_NAME=autofilter

# Enable file-size display in search results (true/false)
SHOW_FILE_SIZE=false
